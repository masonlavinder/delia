[Unit]
Description=LED panel web API (unprivileged, talks to the renderer over a socket)
Requires=panel-renderer.service
After=panel-renderer.service

[Service]
Type=simple
# Unprivileged. Membership in `panel` is the ONLY thing granting socket access;
# this process performs no privileged operation.
User=mlavinder
SupplementaryGroups=panel
Environment=PANEL_SOCK=/run/panel/panel.sock
# Optional, for the natural-language ask box: ANTHROPIC_API_KEY=sk-ant-...
# (and optionally PANEL_AI_MODEL / PANEL_AI_EFFORT). The leading `-` means the
# file may be absent — no key, no ask box, everything else unaffected. Kept out
# of git and out of rsync, so the Pi owns its own copy.
EnvironmentFile=-/home/mlavinder/delia/.env
# Serves the API plus the pre-built React client from ../client/dist. The client
# is built on a dev machine and rsynced; nothing is compiled on the Pi.
WorkingDirectory=/home/mlavinder/delia/web_app/server
ExecStart=/usr/bin/python3 /home/mlavinder/delia/web_app/server/server.py
Restart=always
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
