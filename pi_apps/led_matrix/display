#!/usr/bin/env bash
# `display` — pick and run a scene on the LED matrix.
#
#   display                 interactive menu (pick a number)
#   display clock           run a scene by short name
#   display everyday/clock  ...or by full group/name
#   display gif cool.gif    pass args through to the scene
#   display list            list scenes
#   display --help          show help
#
# Install once as a global command:
#   sudo ln -sf ~/delia/pi_apps/led_matrix/display /usr/local/bin/display
#
# Ctrl-C stops a running scene.
set -uo pipefail

# Resolve the led_matrix dir even when called via the /usr/local/bin symlink.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")" && pwd)"
SCENES_DIR="$ROOT/scenes"

mapfile -t SCENES < <(cd "$ROOT" && find scenes -name '*.py' -not -name '__*' \
  | sed 's|scenes/||; s|\.py$||' | sort)

desc() { sed -n '1s/^"""//p' "$SCENES_DIR/$1.py" 2>/dev/null | cut -c1-46; }

show_list() {
  echo "Available displays:"
  local i=1
  for s in "${SCENES[@]}"; do
    printf "  %2d. %-16s %s\n" "$i" "$s" "$(desc "$s")"
    i=$((i + 1))
  done
}

resolve() {  # accept "clock" or "everyday/clock"
  local q="$1"
  for s in "${SCENES[@]}"; do
    [[ "$s" == "$q" || "${s##*/}" == "$q" ]] && { echo "$s"; return 0; }
  done
  return 1
}

run() {  # run "<group/name>" [args...]
  local scene="$1"; shift
  echo "running $scene  (Ctrl-C to stop)"
  exec sudo env "PYTHONPATH=$ROOT" python3 "$SCENES_DIR/$scene.py" "$@"
}

case "${1:-}" in
  -h|--help|help)
    sed -n '2,13p' "$SELF" | sed 's/^# \{0,1\}//'
    echo
    show_list
    ;;
  list)
    show_list
    ;;
  "")
    show_list
    echo
    read -rp "pick a number (or q to quit): " n
    [[ "$n" == q || -z "$n" ]] && exit 0
    if [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#SCENES[@]} )); then
      run "${SCENES[$((n - 1))]}"
    else
      echo "invalid choice"; exit 1
    fi
    ;;
  *)
    scene="$(resolve "$1")" || { echo "no scene '$1'"; echo; show_list; exit 1; }
    shift
    run "$scene" "$@"
    ;;
esac
